  m_Script: {fileID: 11500000, guid: 560208ccab5a7f5fd0870e77eedf3a8b, type: 3}
  m_Name: Readme
  m_EditorClassIdentifier: 
  icon: {fileID: 2800000, guid: f84532c0fa8923249bcb6e4938d7ef49, type: 3}
  title: LiveStudio SDK + VirgoMotion
  titleTranslations:
  - language: ja
    title: LiveStudio SDK + VirgoMotion
  - language: zh-CN
    title: LiveStudio SDK + VirgoMotion
  sections:
  - heading: Welcome to LiveStudio SDK + VirgoMotion
    text: A starter project for building 3D VTuber live-streaming apps. Create your own original streaming app.
    linkText: 
    url: 
    buttonText: 
    buttonAction: 
    translations:
    - language: ja
      heading: "LiveStudio SDK + VirgoMotion \u3078\u3088\u3046\u3053\u305D"
      text: "3D VTuber \u914D\u4FE1\u30A2\u30D7\u30EA\u3092\u69CB\u7BC9\u3059\u308B\u305F\u3081\u306E\u30B9\u30BF\u30FC\u30BF\u30FC\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u3067\u3059\u3002\u3042\u306A\u305F\u30AA\u30EA\u30B8\u30CA\u30EB\u306E\u914D\u4FE1\u30A2\u30D7\u30EA\u3092\u4F5C\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059"
      linkText: 
      buttonText: 
    - language: zh-CN
      heading: "\u6B22\u8FCE\u4F7F\u7528 LiveStudio SDK + VirgoMotion"
      text: "\u7528\u4E8E\u6784\u5EFA 3D VTuber \u76F4\u64AD\u5E94\u7528\u7684\u5165\u95E8\u9879\u76EE\u3002\u53EF\u4EE5\u521B\u5EFA\u5C5E\u4E8E\u4F60\u81EA\u5DF1\u7684\u539F\u521B\u76F4\u64AD\u5E94\u7528\u3002"
      linkText:
      buttonText:
  - heading: Quick Start
    text: 
    linkText: 
    url: 
    buttonText: 
    buttonAction: 
    translations:
    - language: ja
      heading: "\u30AF\u30A4\u30C3\u30AF\u30B9\u30BF\u30FC\u30C8"
      text: 
      linkText: 
      buttonText: 
    - language: zh-CN
      heading: "\u5FEB\u901F\u5F00\u59CB"
      text: 
      linkText: 
      buttonText: 
  - heading: 
    text: 1. Open the SampleStudio scene.
    linkText: 
    url: 
    buttonText: Open SampleStudio
    buttonAction: openSampleStudio
    translations:
    - language: ja
      heading: 
      text: "1. SampleStudio \u30B7\u30FC\u30F3\u3092\u958B\u304D\u307E\u3059\u3002"
      linkText: 
      buttonText: "SampleStudio \u3092\u958B\u304F"
    - language: zh-CN
      heading: 
      text: "1. \u6253\u5F00 SampleStudio \u573A\u666F\u3002"
      linkText: 
      buttonText: "\u6253\u5F00 SampleStudio"
  - heading:
    text: 2. Launch the RemoteApp.
    linkText:
    url:
    buttonText: Launch RemoteApp
    buttonAction: launchRemoteApp
    translations:
    - language: ja
      heading:
      text: "2. \u30EA\u30E2\u30FC\u30C8\u30A2\u30D7\u30EA\u3092\u8D77\u52D5\u3057\u307E\u3059\u3002"
      linkText:
      buttonText: "\u30EA\u30E2\u30FC\u30C8\u30A2\u30D7\u30EA\u3092\u8D77\u52D5"
    - language: zh-CN
      heading:
      text: "2. \u542F\u52A8 RemoteApp\u3002"
      linkText:
      buttonText: "\u542F\u52A8 RemoteApp"
  - heading:
    text: '3. Open the RemoteApp home page and complete the setup. Don''t forget to enter your license info.'
    linkText:
    url:
    buttonText:
    buttonAction:
    translations:
    - language: ja
      heading:
      text: "3. \u30EA\u30E2\u30FC\u30C8\u30A2\u30D7\u30EA\u306E\u30DB\u30FC\u30E0\u30DA\u30FC\u30B8\u3092\u78BA\u8A8D\u3057\u3001\u30BB\u30C3\u30C8\u30A2\u30C3\u30D7\u3092\u5B8C\u4E86\u3057\u3066\u304A\u304D\u307E\u3059\u3002\u30E9\u30A4\u30BB\u30F3\u30B9\u60C5\u5831\u306E\u5165\u529B\u3082\u5FD8\u308C\u305A\u306B\u3002"
      linkText:
      buttonText:
    - language: zh-CN
      heading:
      text: "3. \u6253\u5F00 RemoteApp \u4E3B\u9875\u5E76\u5B8C\u6210\u8BBE\u7F6E\u3002\u522B\u5FD8\u4E86\u8F93\u5165\u6388\u6743\u4FE1\u606F\u3002"
      linkText:
      buttonText:
  - heading:
    text: 4. Enter Play mode to start streaming motion to your avatar.
    linkText: 
    url: 
    buttonText: 
    buttonAction: 
    translations:
    - language: ja
      heading: 
      text: "4. Play \u30E2\u30FC\u30C9\u306B\u5165\u308A\u3001\u30A2\u30D0\u30BF\u30FC\u3078\u306E\u30E2\u30FC\u30B7\u30E7\u30F3\u914D\u4FE1\u3092\u958B\u59CB\u3057\u307E\u3059\u3002"
      linkText: 
      buttonText: 
    - language: zh-CN
      heading: 
      text: "4. \u8FDB\u5165 Play \u6A21\u5F0F\uFF0C\u5F00\u59CB\u5411\u865A\u62DF\u5F62\u8C61\u63A8\u9001\u52A8\u4F5C\u6570\u636E\u3002"
      linkText:
      buttonText:
  - heading:
    text: "5. When you're done verifying, exit Play mode and close the RemoteApp."
    linkText:
    url:
    buttonText:
    buttonAction:
    translations:
    - language: ja
      heading:
      text: "5. \u52D5\u4F5C\u78BA\u8A8D\u3057\u305F\u3089\u518D\u751F\u505C\u6B62\u3002\u30EA\u30E2\u30FC\u30C8\u30A2\u30D7\u30EA\u3082\u7D42\u4E86\u3057\u3066\u304A\u304D\u307E\u3059\u3002"
      linkText:
      buttonText:
    - language: zh-CN
      heading:
      text: "5. \u786E\u8BA4\u65E0\u8BEF\u540E\u9000\u51FA Play \u6A21\u5F0F\u5E76\u5173\u95ED RemoteApp\u3002"
      linkText:
      buttonText:
  - heading:
    text: 6. Build & Run to produce a standalone Studio player.
    linkText: 
    url: 
    buttonText: Build & Run
    buttonAction: buildAndRun
    translations:
    - language: ja
      heading: 
      text: "6. Build & Run \u3067\u30B9\u30BF\u30F3\u30C9\u30A2\u30ED\u30F3\u306E
        Studio \u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u30D3\u30EB\u30C9\u30FB\u5B9F\u884C\u3057\u307E\u3059\u3002"
      linkText: 
      buttonText: "\u30D3\u30EB\u30C9\u3057\u3066\u5B9F\u884C"
    - language: zh-CN
      heading: 
      text: "6. \u4F7F\u7528 Build & Run \u6784\u5EFA\u5E76\u8FD0\u884C\u72EC\u7ACB\u7684
        Studio \u64AD\u653E\u5668\u3002"
      linkText: 
      buttonText: "\u6784\u5EFA\u5E76\u8FD0\u884C"
  - heading: Documentation
    text:
    linkText: docs.virgomotion.com/sdk/knowledge/vtuber-streaming-app
    url: https://docs.virgomotion.com/sdk/knowledge/vtuber-streaming-app
    buttonText:
    buttonAction:
    translations:
