/*
 * Sibling of the LiveData Viewer's sheet, and deliberately built from the same parts: the status
 * bar, the transport and the pills read the same because they mean the same thing. What differs is
 * what this window does with them -- the viewer watches a lane, this one drives the take.
 *
 * Colours are stated as an alpha over whatever is behind them, so nothing here branches on the
 * editor skin.
 */

.lds-root {
    flex-grow: 1;
}

/* --- status bar ------------------------------------------------------- */

.lds-status {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    background-color: rgba(0, 0, 0, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.lds-status-item {
    margin-right: 12px;
    -unity-text-align: middle-left;
}

/* The position, which ticks every frame. Fixed width in a fixed-width face, so the rest of the bar
   does not shuffle sideways as the digits grow or as it switches to a timecode. */
.lds-num {
    min-width: 104px;
    flex-shrink: 0;

    /* A point over the rest of the bar: a monospace face carries a smaller x-height at the same
       nominal size, so matching the number makes it read smaller than what sits beside it. */
    font-size: 14px;

    /* The face is built at runtime and brings its own ascent, so centring the line box still leaves
       the glyphs riding high -- the alignment property centres the box, not what is drawn inside. */
    padding-top: 3px;

    -unity-text-align: middle-right;
    margin-right: 10px;
}

.lds-num:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 3px;
}

.lds-pill {
    padding: 0 6px;
    border-radius: 7px;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.08);
}

/* Recording. Red, and the only red in the window: nothing else may be mistaken for it. */
.lds-pill-rec {
    background-color: rgba(170, 60, 55, 0.75);
    color: rgb(255, 235, 235);
}

.lds-pill-play {
    background-color: rgba(70, 140, 90, 0.55);
}

/* Playing, but held. Amber against the green above: moving or not, read off one pill. */
.lds-pill-hold {
    background-color: rgba(150, 120, 40, 0.65);
}

/* --- banners ---------------------------------------------------------- */

.lds-banner {
    flex-shrink: 0;
    padding: 5px 8px;
    white-space: normal;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.lds-banner-warning {
    background-color: rgba(150, 120, 40, 0.45);
}

.lds-banner-danger {
    background-color: rgba(150, 55, 50, 0.55);
}

/* --- transport -------------------------------------------------------- */

/* Fixed height like the status bar above it: it must not give up room as the list below it fills,
   or the control that moves through a take shrinks out of reach. */
.lds-transport {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
}

.lds-transport > Button {
    flex-shrink: 0;
    margin: 0 2px;
    min-width: 28px;
}

/* The one button that starts a take. Marked out because it is the only control here that writes a
   file, and because a stopped take and a running one have to be told apart at a glance. */
.lds-record {
    min-width: 74px;
    color: rgb(225, 120, 115);
    -unity-font-style: bold;
}

.lds-record-on {
    background-color: rgba(170, 60, 55, 0.75);
    color: rgb(255, 235, 235);
}

.lds-play {
    min-width: 74px;
    -unity-font-style: bold;
}

.lds-play-on {
    background-color: rgba(70, 140, 90, 0.5);
}

/* Held. Lit while it is holding, because a pause that looks the same as a play is a pause people
   forget they left on -- and here that reads as "the replay is stuck". */
.lds-hold-on {
    background-color: rgba(150, 120, 40, 0.6);
}

.lds-divider {
    width: 1px;
    height: 16px;
    flex-shrink: 0;
    margin: 0 6px;
    background-color: rgba(255, 255, 255, 0.15);
}

.lds-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    margin: 0 6px;
}

.lds-position {
    flex-shrink: 0;
    min-width: 104px;
    -unity-text-align: middle-right;
    margin: 0 6px;
}

/* --- take list -------------------------------------------------------- */

.lds-lane-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    background-color: rgba(0, 0, 0, 0.12);
}

/* flex-basis 0 rather than auto: with auto a long list makes the pane ask for its whole content
   height, and that room has to come out of the header above it. min-height 0 lets it go below its
   content, which is what a scroll view is for. */
.lds-page {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}

.lds-take {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 6px 2px 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.lds-take:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.lds-take-selected {
    background-color: rgba(70, 110, 170, 0.45);
}

/* The take on the gate right now -- being recorded into, or being played. */
.lds-take-active {
    border-left-color: rgb(110, 180, 120);
}

.lds-take-recording {
    border-left-color: rgb(200, 80, 75);
}

.lds-take-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Fixed columns so the numbers line up down the list rather than following the names. */
.lds-col-frames {
    min-width: 78px;
    max-width: 78px;
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.lds-col-duration {
    min-width: 86px;
    max-width: 86px;
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.lds-col-size {
    min-width: 74px;
    max-width: 74px;
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.lds-col-date {
    min-width: 118px;
    max-width: 118px;
    -unity-text-align: middle-right;
    margin-left: 8px;
    opacity: 0.6;
}

/* Removes the take on its row.

   Present on every row rather than revealed on hover -- a control that only exists once the pointer
   is already over it is one nobody knows is there -- but dimmed until the row is under the pointer,
   so a list of takes reads as a list rather than as a column of buttons.

   Dimmed, not hidden: legible on its own at rest, so finding it does not depend on the
   descendant-hover rule below actually matching. */
.lds-delete {
    flex-shrink: 0;
    width: 20px;
    min-width: 20px;
    height: 15px;
    margin: 0 0 0 10px;
    padding: 0;
    font-size: 10px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(200, 120, 115);
    opacity: 0.45;
}

.lds-take:hover > .lds-delete {
    opacity: 0.9;
}

/* Lit only once the pointer is actually on it: this one does not ask twice by accident. */
.lds-delete:hover {
    opacity: 1;
    background-color: rgba(170, 60, 55, 0.75);
    color: rgb(255, 235, 235);
}

.lds-delete:disabled {
    opacity: 0.15;
}

.lds-empty {
    flex-shrink: 0;
    padding: 10px;
    white-space: normal;
}
