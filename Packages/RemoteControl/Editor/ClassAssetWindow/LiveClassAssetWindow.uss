/* Layout specific to the Live Class Asset windows; everything generic lives in
 * Editor/Styles/RemoteControlEditor.uss and is referenced through the shared class names in
 * LiveClassAssetStyles. */

/* --- Header: preset asset and container --- */

/* Inspector-style rows rather than toolbars: an ObjectField squeezed into a 21px Toolbar sits
 * taller than the bar and loses its margins, which is what made the two rows read as one wide
 * text field instead of two labelled properties. */
.lca-header {
    flex-shrink: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 127, 127, 0.35);
}

.lca-header-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.lca-header-row__field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
}

/* A fixed label column instead of Unity's aligned-field rule, which sizes the label as a
 * fraction of the pane and would run to a few hundred pixels in a wide window. */
.lca-header-row__field > .unity-base-field__label {
    width: 62px;
    min-width: 62px;
}

/* The action column keeps its width when its button is hidden, so both fields end at the same
 * x whether or not a container still has to be created. */
.lca-header-row__action {
    width: 54px;
    flex-shrink: 0;
    margin-left: 4px;
}

.lca-header-row__action > Button {
    margin-left: 0;
    margin-right: 0;
    flex-grow: 1;
}

/* --- Panes --- */

/* The minimums are what the surrounding TwoPaneSplitView clamps its dragline to, so they belong
 * to this window rather than to the shared .rc-pane. */
.lca-pane {
    flex-grow: 1;
    flex-direction: column;
    min-width: 160px;
    min-height: 60px;
}

/* Continues the split view's dragline through the pane toolbars, which paint over it. */
.lca-pane--divided {
    border-right-width: 1px;
    border-right-color: rgba(127, 127, 127, 0.35);
}

/* Title of a pane toolbar. Toolbar children sit flush against the bar's edge, so the padding
 * that keeps the text off the divider has to come from here. */
.lca-pane-title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    padding-left: 4px;
    padding-right: 6px;
}

/* Secondary text beside a pane title (namespace, unresolved marker). */
.lca-pane-header-detail {
    -unity-text-align: middle-left;
    padding-right: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.6;
}

/* --- Empty states --- */

/* What a pane shows in place of a list it has no entries for. Dimmed running text the way
 * Unity's own empty lists read - a bordered HelpBox with no icon looks like a disabled text
 * field, not like guidance. */
.lca-empty {
    white-space: normal;
    -unity-text-align: middle-center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    opacity: 0.6;
    flex-shrink: 0;
}

/* --- Row buttons --- */

/* Borderless glyph button for the remove / reorder affordances that sit inside a list row.
 * A framed Button per row reads as heavier than the row it acts on. */
.lca-row-button {
    width: 18px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.55;
    -unity-text-align: middle-center;
}

.lca-row-button:hover {
    opacity: 1;
    background-color: rgba(127, 127, 127, 0.25);
}

.lca-row-button:disabled {
    opacity: 0.2;
}

/* --- Class list rows --- */

.lca-class-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding-left: 4px;
}

.lca-class-row__title {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.lca-class-row__title--unresolved {
    opacity: 0.6;
}

.lca-class-row__count {
    flex-shrink: 0;
    margin-right: 6px;
    opacity: 0.6;
    -unity-text-align: middle-right;
}

/* --- Class detail --- */

/* Keeps the class-level fields off the pane edge, and at the same indent as the member cards
 * below them so both label columns line up. */
.lca-detail {
    padding-top: 4px;
    padding-left: 4px;
    padding-right: 4px;
}

/* --- Member cards --- */

.lca-member__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.lca-member__title {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* What one object of this type costs in a frame. Sits with the class-level fields because the
 * budget belongs to the type, not to any one member. */
.lca-state-budget {
    margin-top: 2px;
    margin-left: 3px;
    margin-bottom: 2px;
    font-size: 10px;
    white-space: normal;
}

/* Which lane carries the member, sitting between the member name and the row's buttons. Small
 * and right-aligned so a column of them reads down the list at a glance, rather than competing
 * with the names it sits beside. */
.lca-member__lane {
    flex-shrink: 0;
    margin-right: 4px;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.lca-member__section-detail {
    margin-left: 12px;
}

/* --- Instance bindings footer --- */

.lca-footer {
    flex-direction: column;
    border-top-width: 1px;
    border-top-color: rgba(127, 127, 127, 0.35);
    min-height: 60px;
    padding-top: 2px;
}

.lca-footer__title {
    -unity-font-style: bold;
}

.lca-binding-row {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    margin-right: 4px;
}

.lca-binding-row__field {
    flex-grow: 1;
    flex-shrink: 1;
}

.lca-binding-row__state {
    flex-shrink: 0;
    width: 64px;
    opacity: 0.6;
    -unity-text-align: middle-right;
}

/* --- Add Member / From Selected popups --- */

.lca-popup-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.lca-popup-row__toggle {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.lca-popup-row__meta {
    flex-shrink: 0;
    min-width: 60px;
    opacity: 0.6;
    -unity-text-align: middle-right;
}

.lca-popup-row__title {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.lca-popup-row__title--added {
    -unity-font-style: bold;
}

.lca-popup-row__button {
    width: 60px;
    flex-shrink: 0;
}
