# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio cache directory
.vs/

# Autogenerated VS/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Lock files
*.lock

# Unity Burst debug artifacts (regenerated next to player builds, never shipped)
*_BurstDebugInformation_DoNotShip/

# OS
.DS_Store
Thumbs.db

# Windows null-device artifact: a tool that passes "/dev/null" as a path makes
# Git for Windows resolve it relative to the repo, so git-lfs installs its hooks
# into a literal dev/null/ directory. Junk (identical to .git/hooks), and it has
# been swept into a commit by "git add -A" before.
/dev/
